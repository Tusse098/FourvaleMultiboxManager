<Application x:Class="Fourvale.Capture.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Fourvale.Capture.Ui"
             ThemeMode="Dark"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="BgColor">#0F0F1A</Color>
            <Color x:Key="PanelColor">#151525</Color>
            <Color x:Key="CardColor">#1C1C30</Color>
            <Color x:Key="CardHoverColor">#25253D</Color>
            <Color x:Key="LineColor">#2A2A44</Color>
            <Color x:Key="TextColor">#EEEAF6</Color>
            <Color x:Key="MutedColor">#9A98B5</Color>
            <Color x:Key="GoldColor">#CAA85A</Color>
            <Color x:Key="RecordColor">#E5484D</Color>
            <Color x:Key="InColor">#6CC4B0</Color>
            <Color x:Key="HttpColor">#8FB7E8</Color>

            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
            <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
            <SolidColorBrush x:Key="RecordBrush" Color="{StaticResource RecordColor}" />
            <SolidColorBrush x:Key="InBrush" Color="{StaticResource InColor}" />
            <SolidColorBrush x:Key="HttpBrush" Color="{StaticResource HttpColor}" />

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <ui:ReadyBrushConverter x:Key="ReadyBrush" />

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Rounded chip button. Not focusable, so game keys (Space/Enter) never trigger it. -->
            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Margin" Value="0,0,5,5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource GoldBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chip" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The big start/stop button: gold when idle, red while recording. -->
            <Style x:Key="RecordButton" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Height" Value="48" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                <Setter Property="Background" Value="{StaticResource GoldBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Face" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Face" Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                        <Setter Property="Background" Value="{StaticResource RecordBrush}" />
                        <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Slot picker pills. Plain buttons: they work without keyboard focus, so game keys never hit them. -->
            <Style x:Key="SlotButton" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Pill" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="0,7" MinWidth="54">
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" HorizontalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsOpen}" Value="False">
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource MutedBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource GoldBrush}" />
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource BgBrush}" />
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Pill" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Small icon buttons in a slot panel header. -->
            <Style x:Key="HeaderButton" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Face" Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
