# Normalise line endings in the repository; check out with the platform's native endings.
* text=auto

*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.slnx    text
*.props   text
*.json    text
*.md      text
*.py      text

# Windows scripts must keep CRLF.
*.cmd     text eol=crlf
*.bat     text eol=crlf
*.ps1     text eol=crlf

# Binary
*.png     binary
*.jpg     binary
*.ico     binary
