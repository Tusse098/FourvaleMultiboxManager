<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Fourvale Multibox Manager</AssemblyTitle>
    <!-- WPF0001: Application.ThemeMode (Fluent dark theme) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Multibox.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Multibox.Hosting\Multibox.Hosting.csproj" />
    <ProjectReference Include="..\Multibox.Core\Multibox.Core.csproj" />
    <ProjectReference Include="..\Fourvale.Adapter\Fourvale.Adapter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="multibox.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
