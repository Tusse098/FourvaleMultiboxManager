<Window x:Class="Multibox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fourvale Multibox Manager"
        Width="1400" Height="860" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <DockPanel>
        <!-- Fullscreen only: touching the top edge reveals the top bar. -->
        <Border x:Name="RevealStrip" DockPanel.Dock="Top" Height="3" Background="{StaticResource PanelBrush}" Visibility="Collapsed"
                MouseEnter="OnRevealTopBar" />

        <!-- Top bar -->
        <Border x:Name="TopBar" DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="12,5" MouseLeave="OnTopBarMouseLeave">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource ChipButton}" Content="Unstick keys" Click="OnUnstickKeys"
                            ToolTip="Shortcuts not working? Clears every slot's 'typing in a text field' state and any held-key state" />
                    <Button Style="{StaticResource ChipButton}" Content="Overlay" Click="OnShowSettings"
                            ToolTip="Party overlay settings: when it shows, click-through, arranging" />
                    <Button Style="{StaticResource ChipButton}" Content="Settings" Click="OnShowSettings" />
                    <Button x:Name="FullscreenButton" Style="{StaticResource ChipButton}" Content="Fullscreen" Click="OnToggleFullscreen"
                            ToolTip="Borderless fullscreen (Alt+Enter). In fullscreen, touch the top edge of the screen to show this bar." />
                    <Button Style="{StaticResource ChipButton}" Content="Live state window" Click="OnShowLiveState"
                            ToolTip="Every slot's game state and the soak-test diagnostics, outside the game view" />
                    <Button Style="{StaticResource ChipButton}" Content="Browser task manager" Click="OnTaskManager"
                            ToolTip="Crash test: end one slot's process here and check that only that slot recovers" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Fourvale Multibox" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="   Slots" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ItemsControl ItemsSource="{Binding SlotPills}" VerticalAlignment="Center"
                                  ToolTip="Click a grey number to open that slot. Close a slot with ✕ on its panel.">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Number}" Command="{Binding Toggle}" Padding="10,2" Margin="4,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource GoldBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="   Layout" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,0,0" />
                    <Button Content="Grid" Command="{Binding SetGridLayout}" Padding="10,2" ToolTip="All open slots in equal tiles">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGridLayout}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource GoldBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Focus" Command="{Binding SetFocusLayout}" Padding="10,2" ToolTip="The focused slot large, the others as small live tiles">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFocusLayout}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource GoldBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding FocusText}" Foreground="{StaticResource FocusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"
                               ToolTip="{Binding ShortcutHelp}" />
                    <TextBlock Text="{Binding Notice}" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- One SlotPanel per open slot, placed by LayoutPlanner as exact 16:9 game tiles (all always visible: discovery H1). -->
        <Grid>
            <TextBlock Text="Click a slot number in the top bar to open a game." Style="{StaticResource Hint}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Canvas x:Name="PanelHost" ClipToBounds="True" />
        </Grid>
    </DockPanel>
</Window>
