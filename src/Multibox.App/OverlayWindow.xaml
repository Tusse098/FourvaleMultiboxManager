<Window x:Class="Multibox.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Party overlay"
        Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Foreground="{StaticResource TextBrush}">
    <!-- Party overlay: every slot's character, read from the state store only. Never takes focus from the game. -->
    <DockPanel>
            <!-- Header: drag to move; – minimises; ✕ closes (reopen with "Overlay" in the top bar).
                 Invisible (and click-through) unless the mouse is over the overlay; always shown while minimised. -->
            <Border DockPanel.Dock="Top" Background="{Binding Background}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="8,8,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Arranging}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            <Grid x:Name="Header" Height="28" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Party" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" Margin="12,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Hint}" FontSize="11.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <Button Grid.Column="2" Style="{StaticResource OverlayButton}" Content="{Binding MinimizeGlyph}" Command="{Binding ToggleMinimized}"
                        ToolTip="Minimise / expand" />
                <Button Grid.Column="3" Style="{StaticResource OverlayButton}" Content="✕" Command="{Binding Close}"
                        ToolTip="Close (reopen with Overlay in the top bar)" Margin="0,0,6,0" />
            </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Cards}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RowFrame" Margin="0,2,0,0" CornerRadius="8" Cursor="Hand"
                                Background="{Binding DataContext.Background, RelativeSource={RelativeSource AncestorType=Window}}"
                                Tag="{Binding}" MouseLeftButtonUp="OnRowClicked" ToolTip="Click to focus this slot">
                        <Border x:Name="Row" Padding="10,7,10,7" CornerRadius="8" Background="Transparent">
                            <StackPanel>
                                <!-- Which character -->
                                <TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="11.5">
                                    <Run Text="{Binding Session.Id.Number, Mode=OneWay}" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" />
                                    <Run Text=" " />
                                    <Run x:Name="NameRun" Text="{Binding Character, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>

                                <!-- HP, SP and the action timer: bars with the number on top -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="HP" Style="{StaticResource Hint}" FontSize="10.5" VerticalAlignment="Center" />
                                    <Grid Grid.Row="0" Grid.Column="1" Height="15">
                                        <Border CornerRadius="3" Background="#33FFFFFF" />
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding HpFraction, Mode=OneWay}" Foreground="{StaticResource HpBrush}" Background="Transparent"
                                                     BorderThickness="0" Height="15" Visibility="{Binding HasHpBar, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding HpText}" FontSize="10.5" Margin="6,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="SP" Style="{StaticResource Hint}" FontSize="10.5" VerticalAlignment="Center" Margin="0,3,0,0" />
                                    <Grid Grid.Row="1" Grid.Column="1" Height="15" Margin="0,3,0,0">
                                        <Border CornerRadius="3" Background="#33FFFFFF" />
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding SpFraction, Mode=OneWay}" Foreground="{StaticResource SpBrush}" Background="Transparent"
                                                     BorderThickness="0" Height="15" Visibility="{Binding HasSpBar, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding SpText}" FontSize="10.5" Margin="6,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="Timer" Style="{StaticResource Hint}" FontSize="10.5" VerticalAlignment="Center" Margin="0,3,0,0" />
                                    <Grid Grid.Row="2" Grid.Column="1" Height="15" Margin="0,3,0,0" ToolTip="Time until this character can act (full bar = READY)">
                                        <Border CornerRadius="3" Background="#33FFFFFF" />
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding MeterFraction, Mode=OneWay}" Foreground="{StaticResource GoldBrush}" Background="Transparent"
                                                     BorderThickness="0" Height="15" Visibility="{Binding HasMeter, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock x:Name="TimerLabel" Text="{Binding TimerText}" FontSize="10.5" Margin="6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="not in battle" FontSize="10.5" Margin="6,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                                   Visibility="{Binding HasMeter, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#22FFFFFF" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                <Setter TargetName="TimerLabel" Property="Foreground" Value="{StaticResource BgBrush}" />
                                <Setter TargetName="TimerLabel" Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                <Setter TargetName="NameRun" Property="Foreground" Value="{StaticResource ProblemBrush}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.OnlyBattleRows, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                    <Condition Binding="{Binding IsInBattle}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="RowFrame" Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
    </DockPanel>
</Window>
