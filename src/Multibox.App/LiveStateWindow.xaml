<Window x:Class="Multibox.App.LiveStateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live state"
        Width="780" Height="640" MinWidth="320" MinHeight="360"
        ShowActivated="False" Topmost="{Binding IsChecked, ElementName=OnTopBox}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <!-- Read from the state store only. UNKNOWN = missing or older than its freshness limit. -->
    <DockPanel Margin="14,12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <CheckBox x:Name="OnTopBox" DockPanel.Dock="Right" Content="On top" IsChecked="True" Focusable="False" VerticalAlignment="Center" />
            <TextBlock Text="Live state" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Soak-test diagnostics -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasViolations}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ProblemBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Browser}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding SoakFile}" Style="{StaticResource Hint}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Width="240" Margin="0,0,10,10" Padding="12,10" CornerRadius="10"
                                Background="{StaticResource CardBrush}" BorderThickness="1" BorderBrush="{StaticResource LineBrush}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="6" Padding="6,1" Background="{StaticResource GoldBrush}"
                                            Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="READY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BgBrush}" />
                                    </Border>
                                    <TextBlock>
                                        <Run Text="{Binding Title, Mode=OneWay}" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold" />
                                        <Run Text="  " />
                                        <Run Text="{Binding Character, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" FontSize="11" Margin="0,2,0,6" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <Run Text="{Binding Connection, Mode=OneWay}" /> · <Run Text="{Binding Health, Mode=OneWay}" /> · <Run Text="{Binding Status, Mode=OneWay}" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" ToolTip="{Binding Age}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Hint}" />
                                                <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                                                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource UnknownBrush}" />
                                                    <Setter TargetName="Value" Property="FontWeight" Value="Normal" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" FontSize="10.5" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource ProblemBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
