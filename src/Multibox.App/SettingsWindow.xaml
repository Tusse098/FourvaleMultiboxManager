<Window x:Class="Multibox.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="520" Height="760" MinWidth="420" MinHeight="420"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">
            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />

            <!-- Party overlay -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Party overlay" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10" Text="HP, SP and the action timer of every character, on top of the game." />

                    <TextBlock Text="Show" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Content="Only in battle" IsChecked="{Binding ShowInBattle}" Margin="0,0,18,0" GroupName="OverlayMode"
                                     ToolTip="Shown while at least one character is in a fight" />
                        <RadioButton Content="Always" IsChecked="{Binding ShowAlways}" Margin="0,0,18,0" GroupName="OverlayMode" />
                        <RadioButton Content="Off" IsChecked="{Binding ShowOff}" GroupName="OverlayMode" />
                    </StackPanel>

                    <CheckBox Content="Click-through (clicks go to the game)" IsChecked="{Binding ClickThrough}" />
                    <TextBlock Text="{Binding ArrangeHint}" Style="{StaticResource Hint}" FontSize="11.5" Margin="28,2,0,8" />

                    <CheckBox Content="Only list characters that are in battle" IsChecked="{Binding OnlyBattleRows}" Margin="0,0,0,10" />

                    <DockPanel>
                        <TextBlock Text="{Binding OpacityText}" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Text="Background" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Slider Minimum="20" Maximum="100" Value="{Binding OpacityPercent}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Shortcuts: click a key, press the new one. Saved per player (app-settings.json). -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14" Margin="0,14,0,0" DataContext="{Binding Shortcuts}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Content="Reset to defaults" Command="{Binding ResetToDefaults}" />
                        <TextBlock Text="Keyboard" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" FontSize="11.5" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="Click a shortcut, then press the new key. Shortcuts without Ctrl or Alt are off while you type in chat or a login field." />

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="{Binding ButtonText}" Command="{Binding Edit}" MinWidth="120">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GoldBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Message}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ProblemBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Hint}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="F-keys can't be used. The game's own keys (Q, I, C, M, Enter, Esc, Tab, ←, →) need Ctrl or Alt. A top-row digit also works on the number pad." />
                </StackPanel>
            </Border>

            <!-- Troubleshooting tools, off for normal play -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Advanced" FontSize="16" FontWeight="SemiBold" />
                    <CheckBox Content="Developer tools" IsChecked="{Binding DeveloperTools}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="11.5" Margin="28,2,0,0" TextWrapping="Wrap"
                               Text="Live state window, soak log and browser task manager, for troubleshooting." />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Hint}" FontSize="11" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
