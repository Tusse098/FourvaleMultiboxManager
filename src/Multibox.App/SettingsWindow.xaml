<Window x:Class="Multibox.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="520" Height="560" MinWidth="420" MinHeight="420"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">
            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />

            <!-- Party overlay -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Party overlay" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10" Text="HP, SP and the action timer of every character, on top of the game." />

                    <TextBlock Text="Show" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Content="Only in battle" IsChecked="{Binding ShowInBattle}" Margin="0,0,18,0" GroupName="OverlayMode"
                                     ToolTip="Shown while at least one character is in a fight" />
                        <RadioButton Content="Always" IsChecked="{Binding ShowAlways}" Margin="0,0,18,0" GroupName="OverlayMode" />
                        <RadioButton Content="Off" IsChecked="{Binding ShowOff}" GroupName="OverlayMode" />
                    </StackPanel>

                    <CheckBox Content="Click-through (clicks go to the game)" IsChecked="{Binding ClickThrough}" />
                    <TextBlock Text="{Binding ArrangeHint}" Style="{StaticResource Hint}" FontSize="11.5" Margin="28,2,0,8" />

                    <CheckBox Content="Only list characters that are in battle" IsChecked="{Binding OnlyBattleRows}" Margin="0,0,0,10" />

                    <DockPanel>
                        <TextBlock Text="{Binding OpacityText}" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Text="Background" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Slider Minimum="20" Maximum="100" Value="{Binding OpacityPercent}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Shortcuts (read-only here; change them in multibox.json) -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Keyboard" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ShortcutHelp}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="11.5" Margin="0,8,0,0" Text="Change shortcuts under &quot;shortcuts&quot; in multibox.json." />
                </StackPanel>
            </Border>

            <!-- Troubleshooting tools, off for normal play -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Advanced" FontSize="16" FontWeight="SemiBold" />
                    <CheckBox Content="Developer tools" IsChecked="{Binding DeveloperTools}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="11.5" Margin="28,2,0,0" TextWrapping="Wrap"
                               Text="Live state window, soak log and browser task manager, for troubleshooting." />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Hint}" FontSize="11" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
