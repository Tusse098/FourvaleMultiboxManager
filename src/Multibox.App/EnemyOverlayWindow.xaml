<local:OverlayWindowBase x:Class="Multibox.App.EnemyOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Multibox.App"
        Title="Enemy overlay"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Foreground="{StaticResource TextBrush}">
    <!-- Enemy overlay: the HP of every enemy in the focused slot's battle, in the game's order (front row first,
         top to bottom). Read from the state store only. Never takes focus from the game. -->
    <DockPanel Width="{x:Static local:OverlayWindowBase.ContentWidth}">
        <DockPanel.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </DockPanel.LayoutTransform>

        <!-- Header: drag to move; ✕ turns the overlay off (back on in Settings). Shown only while arranging. -->
        <Border DockPanel.Dock="Top" Background="{Binding Background}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="0,1,0,0"
                CornerRadius="8,8,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHovered}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Arranging}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid x:Name="Header" Height="28" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Enemies" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" Margin="12,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="of the focused slot's battle" Style="{StaticResource Hint}" FontSize="11.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <Button Grid.Column="2" Style="{StaticResource OverlayButton}" Content="✕" Command="{Binding Close}"
                        ToolTip="Turn off (back on in Settings)" Margin="0,0,6,0" />
            </Grid>
        </Border>

        <!-- Corner grip, only while arranging: drag to change the overlay's size. -->
        <Thumb x:Name="Grip" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Width="20" Height="20" Margin="0,2,0,0" Cursor="SizeNWSE"
               ToolTip="Drag to change the size" Visibility="{Binding Arranging, Converter={StaticResource BoolToVisibility}}">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{Binding Background}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="0,0,1,1" CornerRadius="0,0,6,0">
                        <Path Data="M 11,2 L 11,11 L 2,11 Z" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" />
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Row" Margin="0,2,0,0" Padding="10,7,10,7" CornerRadius="8"
                            Background="{Binding DataContext.Background, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HP" Style="{StaticResource Hint}" FontSize="10.5" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Height="15">
                                <Border CornerRadius="3" Background="#33FFFFFF" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding HpFraction, Mode=OneWay}" Foreground="{StaticResource HpBrush}" Background="Transparent"
                                             BorderThickness="0" Height="15" />
                                <TextBlock Text="{Binding HpText}" FontSize="10.5" Margin="6,0" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsAlive}" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</local:OverlayWindowBase>
